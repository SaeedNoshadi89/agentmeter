#!/usr/bin/env python3
"""agentmeter: how much of your coding agents' usage limits is left.

Finds the agents installed on this machine and shows each one's limits:
  Claude Code  5-hour + weekly, per account   GET api.anthropic.com/api/oauth/usage
  Codex        5-hour + weekly                 last `rate_limits` in ~/.codex/sessions (local)
  OpenCode     per login in its auth.json      OpenRouter key budget, Claude subscription, ...
  others       listed when installed (Gemini CLI, Cursor Agent, Amp, Copilot CLI, ...)

Usage:
  agentmeter [--json] [--popup]               every agent found
  agentmeter --claude-config DIR               one Claude account (its CLAUDE_CONFIG_DIR)
  agentmeter --pid PID                         the account of a running Claude Code process
  agentmeter setup-rex [--key shift+cmd+u]   add the popup to Rex's init.lua
  agentmeter remove-rex                      take it out again
  agentmeter --version
"""
import glob, json, os, subprocess, sys, time, urllib.request
from datetime import datetime, timezone

VERSION = "0.1.0"

CACHE = os.path.expanduser("~/.cache/agentmeter.json")
CACHE_TTL = 60


def meter(label, used, resets_at=None, detail=None):
    """One limit: share used (0-100) and when it resets. A past reset means it's fresh again."""
    if used is None:
        return None
    if resets_at and resets_at < time.time():
        used, resets_at = 0.0, None
    used = max(0.0, min(100.0, float(used)))
    return {"label": label, "used": used, "left": 100.0 - used, "resets_at": resets_at, "detail": detail}


def iso(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp() if ts else None


def http_json(url, headers):
    req = urllib.request.Request(url, headers={"User-Agent": "agentmeter", **headers})
    try:
        return json.load(urllib.request.urlopen(req, timeout=8))
    except urllib.error.HTTPError as e:
        raise RuntimeError("login expired" if e.code in (401, 403) else f"HTTP {e.code}")


# ---- Claude Code ---------------------------------------------------------
# Each Claude Code login lives in a config dir: the default (~/.claude, account
# info in ~/.claude.json) or one chosen with CLAUDE_CONFIG_DIR. On macOS its
# token is in the Keychain item "Claude Code-credentials", plus
# "-<first 8 hex of sha256(dir)>" for a custom dir.
import hashlib, re


def keychain_service(cfg):
    base = "Claude Code-credentials"
    return base if cfg is None else f"{base}-{hashlib.sha256(cfg.encode()).hexdigest()[:8]}"


def read_credentials(cfg):
    if sys.platform == "darwin":
        r = subprocess.run(["security", "find-generic-password", "-s", keychain_service(cfg), "-w"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return r.stdout
    p = os.path.join(cfg or os.path.expanduser("~/.claude"), ".credentials.json")
    return open(p).read() if os.path.exists(p) else None


def claude_email(cfg):
    p = os.path.join(cfg, ".claude.json") if cfg else os.path.expanduser("~/.claude.json")
    try:
        return (json.load(open(p)).get("oauthAccount") or {}).get("emailAddress")
    except Exception:
        return None


def claude_accounts():
    """Config dirs (None = default) that have a Claude Code login."""
    found = [None] if read_credentials(None) else []
    for d in sorted(glob.glob(os.path.expanduser("~/.claude-*")) + glob.glob(os.path.expanduser("~/.config/claude*"))):
        if os.path.isdir(d) and read_credentials(d):
            found.append(d)
    return found or [None]


def pane_claude_dir(pid):
    """CLAUDE_CONFIG_DIR of a running Claude Code process (None = default dir)."""
    env = subprocess.run(["ps", "eww", "-p", str(pid), "-o", "command="], capture_output=True, text=True).stdout
    m = re.search(r"(?:^|\s)CLAUDE_CONFIG_DIR=(\S+)", env)
    return os.path.expanduser(m.group(1)).rstrip("/") if m else None


def claude_usage(token):
    d = http_json("https://api.anthropic.com/api/oauth/usage",
                  {"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"})
    f, w = d.get("five_hour") or {}, d.get("seven_day") or {}
    return {"meters": [meter("5-hour", f.get("utilization"), iso(f.get("resets_at"))),
                       meter("Weekly", w.get("utilization"), iso(w.get("resets_at")))]}


def claude(cfg):
    raw = read_credentials(cfg)
    if not raw:
        raise RuntimeError("not logged in (run `claude`)")
    try:
        return claude_usage(json.loads(raw)["claudeAiOauth"]["accessToken"])
    except RuntimeError as e:
        raise RuntimeError(f"{e} (run `claude`)")


# ---- Codex ---------------------------------------------------------------
def codex():
    files = sorted(glob.glob(os.path.expanduser("~/.codex/sessions/*/*/*/rollout-*.jsonl")),
                   key=os.path.getmtime, reverse=True)
    for path in files[:20]:  # newest session that has rate-limit data
        last = None
        with open(path, errors="ignore") as fh:
            for line in fh:
                if '"rate_limits"' in line:
                    last = line
        if not last:
            continue
        rl = find_key(json.loads(last), "rate_limits")
        if not rl:
            continue
        meters = []
        for slot in ("primary", "secondary"):
            s = rl.get(slot) or {}
            label = "5-hour" if s.get("window_minutes", 0) <= 300 else "Weekly"
            meters.append(meter(label, s.get("used_percent"), s.get("resets_at")))
        return {"meters": meters, "as_of": os.path.getmtime(path)}
    raise RuntimeError("no Codex session data yet")


def find_key(obj, key):
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        obj = obj.values()
    if isinstance(obj, (list, type({}.values()))):
        for v in obj:
            r = find_key(v, key)
            if r:
                return r
    return None


# ---- OpenCode ------------------------------------------------------------
# OpenCode can sign in to many providers; ~/.local/share/opencode/auth.json
# holds one login per provider. Each becomes its own entry.
OPENCODE_AUTH = os.path.expanduser("~/.local/share/opencode/auth.json")
PROVIDER_NAMES = {"openrouter": "OpenRouter", "anthropic": "Claude", "openai": "OpenAI",
                  "github-copilot": "GitHub Copilot", "google": "Google"}


def openrouter(key):
    d = http_json("https://openrouter.ai/api/v1/key", {"Authorization": f"Bearer {key}"}).get("data") or {}
    limit, left = d.get("limit"), d.get("limit_remaining")
    if not limit:
        return {"meters": [], "note": f"${d.get('usage') or 0:.2f} spent, no budget set"}
    budget = d.get("effective_budget") or {}
    period = {"daily": "Daily", "weekly": "Weekly", "monthly": "Monthly"}.get(d.get("limit_reset"), "Budget")
    used = 100 * (1 - (left or 0) / limit)
    return {"meters": [meter(period, used, iso(budget.get("resets_at")), f"${left:,.0f} of ${limit:,.0f}")]}


def opencode_entries():
    try:
        auth = json.load(open(OPENCODE_AUTH))
    except Exception:
        return [("opencode", None, lambda: {"meters": [], "note": "not signed in to a provider"})]
    out = []
    for prov, cred in auth.items():
        name = PROVIDER_NAMES.get(prov, prov)
        if prov == "openrouter" and cred.get("key"):
            fetch = lambda k=cred["key"]: openrouter(k)
        elif prov == "anthropic" and cred.get("type") == "oauth":
            fetch = lambda c=cred: (claude_usage(c["access"]) if c.get("expires", 0) / 1000 > time.time()
                                    else {"meters": [], "note": "token expired, open OpenCode to refresh"})
        else:
            kind = "API key, pay as you go" if cred.get("type") == "api" else "no usage limits to show"
            fetch = lambda kind=kind: {"meters": [], "note": kind}
        out.append((f"opencode:{prov}", f"via {name}", fetch))
    return out


# ---- agent registry -------------------------------------------------------
# An agent is shown when its command is installed or its data folder exists.
# The PATH is widened because Rex starts the popup without your shell's PATH.
EXTRA_PATH = ["~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin", "~/.opencode/bin",
              "~/.bun/bin", "~/.npm-global/bin", "~/.volta/bin", "~/.cargo/bin"]


def installed(bins=(), paths=()):
    import shutil
    path = os.pathsep.join([os.environ.get("PATH", "")] + [os.path.expanduser(p) for p in EXTRA_PATH])
    return (any(shutil.which(b, path=path) for b in bins)
            or any(os.path.exists(os.path.expanduser(p)) for p in paths))


def listed_only(note="no usage limits to show"):
    return lambda: [("", None, lambda: {"meters": [], "note": note})]


# (id, display name, detect, entries) - entries -> [(key suffix, account, fetch)]
AGENTS = [
    ("claude", "Claude Code", lambda: installed(["claude"], ["~/.claude.json", "~/.claude"]), None),
    ("codex", "Codex", lambda: installed(["codex"], ["~/.codex/sessions"]),
     lambda: [("", None, codex)]),
    ("opencode", "OpenCode", lambda: installed(["opencode"], [OPENCODE_AUTH]), opencode_entries),
    ("gemini", "Gemini CLI", lambda: installed(["gemini"]), listed_only()),
    ("cursor", "Cursor Agent", lambda: installed(["cursor-agent"]), listed_only()),
    ("amp", "Amp", lambda: installed(["amp"]), listed_only()),
    ("copilot", "Copilot CLI", lambda: installed(["copilot"]), listed_only()),
    ("qwen", "Qwen Code", lambda: installed(["qwen"]), listed_only()),
    ("crush", "Crush", lambda: installed(["crush"]), listed_only()),
    ("droid", "Factory Droid", lambda: installed(["droid"]), listed_only()),
    ("aider", "Aider", lambda: installed(["aider"]), listed_only("uses your own API keys")),
]


def jobs_for(claude_dirs):
    jobs = []
    for aid, name, detect, entries in AGENTS:
        if aid == "claude":
            if claude_dirs is None and not detect():
                continue
            for d in (claude_dirs if claude_dirs is not None else claude_accounts()):
                jobs.append((f"claude:{d or 'default'}", aid, name, claude_email(d), lambda d=d: claude(d)))
        elif detect():
            for suffix, account, fetch in entries():
                jobs.append((suffix if ":" in suffix else aid + (f":{suffix}" if suffix else ""),
                             aid, name, account, fetch))
    return jobs


# ---- collect + cache -----------------------------------------------------
def collect(fresh=False, claude_dirs=None):
    """Usage per entry, in display order. Each entry is cached for CACHE_TTL."""
    try:
        cache = json.load(open(CACHE))
        cache = cache if isinstance(cache, dict) and "data" not in cache else {}
    except Exception:
        cache = {}
    data, now = {}, time.time()
    for key, aid, label, account, fn in jobs_for(claude_dirs):
        hit = cache.get(key)
        if not fresh and hit and now - hit["at"] < CACHE_TTL and "agent" in hit["data"]:
            data[key] = hit["data"]
            continue
        try:
            v = fn()
            v["meters"] = [m for m in v.get("meters", []) if m]
        except Exception as e:
            v = {"error": str(e)}
        v.update(agent=aid, label=label, account=account)
        cache[key] = {"at": now, "data": v}
        data[key] = v
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w") as fh:
        json.dump(cache, fh)
    return data


# ---- render --------------------------------------------------------------
# Minimal and theme-friendly: basic ANSI colors only (Rex maps them to its
# palette), thin line bars, muted secondary text, title in the pane header.
DIM, BOLD, RESET = "\033[2m", "\033[1m", "\033[0m"
# Each tool's own mark where it has one: Claude Code's spark in Claude orange,
# Codex CLI's prompt, Gemini's sparkle in Gemini blue.
ICONS = {"claude": ("\033[38;2;217;119;87m", "✻ "), "codex": ("", ">_"),
         "gemini": ("\033[38;2;71;150;227m", "✦ "), "opencode": ("", "▣ ")}


def icon(aid, muted=False):
    color, mark = ICONS.get(aid, ("", "◆ "))
    return f"{DIM if muted else color}{BOLD}{mark}{RESET}"


GREEN, ORANGE, RED = "\033[32m", "\033[38;5;208m", "\033[31m"


def tone(left):
    """Color for the share left, same for every agent and window."""
    return GREEN if left >= 50 else ORANGE if left >= 30 else RED


def bar(m, width):
    """Thin bar with half-cell precision: ━ full, ╸ half, ─ track."""
    halves = round(m["left"] / 100 * width * 2)
    full, half = divmod(halves, 2)
    filled = "━" * full + ("╸" if half else "")
    return f"{tone(m['left'])}{filled}{RESET}{DIM}{'─' * (width - len(filled))}{RESET}"


def reset_text(ts):
    if not ts:
        return ""
    secs = ts - time.time()
    if secs < 86400:
        h, m = int(secs // 3600), int(secs % 3600 // 60)
        return f"↻ {h}h {m:02d}m" if h else f"↻ {m}m"
    fmt = "%a %H:%M" if secs < 6 * 86400 else "%b %d"
    return "↻ " + time.strftime(fmt, time.localtime(ts))


def visible_len(text):
    import re
    return len(re.sub(r"\033\[[0-9;?]*[A-Za-z]", "", text))


SHORT = {"5-hour": "5h", "Weekly": "week", "Monthly": "month", "Daily": "day", "Budget": "budget"}


def lines_for(data, bar_w):
    out = []
    for u in data.values():
        aid = u.get("agent", "")
        title = f"{BOLD}{u.get('label', aid)}{RESET}"
        if u.get("account"):
            title += f"  {DIM}{u['account']}{RESET}"
        if "as_of" in u:
            title += f"   {DIM}as of {time.strftime('%H:%M', time.localtime(u['as_of']))}{RESET}"
        quiet = "error" in u or not u.get("meters")
        out.append(f"{icon(aid, muted=quiet)} {title}")
        if "error" in u or u.get("note"):
            out.append(f"   {DIM}{u.get('error') or u['note']}{RESET}")
        for m in u.get("meters", []):
            extra = "  ".join(x for x in (m.get("detail"), reset_text(m.get("resets_at"))) if x)
            out.append(f"   {DIM}{SHORT.get(m['label'], m['label']):<6}{RESET}{bar(m, bar_w)}  "
                       f"{tone(m['left'])}{m['left']:3.0f}%{RESET}  {DIM}{extra}{RESET}")
        out.append("")
    return out


def render(data, popup=False):
    import shutil
    if not popup:
        cols = shutil.get_terminal_size((80, 24)).columns
        body = lines_for(data, max(10, min(28, cols - 50)))
        print("\n" + "\n".join("  " + l for l in body))
        return
    body = lines_for(data, 16)
    while body and not body[-1]:
        body.pop()
    fit_rex_layer(len(body) + 2, max(visible_len(l) for l in body) + 4)
    print("\033]2;Agent usage\007\033[?25l\033[H\033[2J\n", end="")
    print("\n".join("  " + l for l in body), end="", flush=True)


def rex_api(method, args):
    """Call the Rex server API from inside a Rex pane; None when not in Rex."""
    import shutil
    bin_dir = os.environ.get("REX_BIN_DIR", "")
    rex_bin = os.path.join(bin_dir, "rex") if os.path.exists(os.path.join(bin_dir, "rex")) else shutil.which("rex")
    if not rex_bin or not os.environ.get("REX_SESSION"):
        return None
    r = subprocess.run([rex_bin, "api", "call", "-s", os.environ["REX_SESSION"], method, json.dumps(args)],
                       capture_output=True, text=True, timeout=3)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None


def fit_rex_layer(rows_needed, cols_needed):
    """Shrink the popup's floating layer to fit its content, centred in the window."""
    block = os.environ.get("REX_BLOCK")
    if not block:
        return
    try:
        for _ in range(3):  # the pane header isn't counted in rows, so converge in a few steps
            view = rex_api("session.view", {}) or {}
            layer = next((l for w in view.get("windows", []) for l in w.get("layers", [])
                          if l.get("kind") != "tiled" and any(b.get("block_id") == block for b in l.get("blocks", []))),
                         None)
            if not layer:
                return
            _, _, w, h = layer["bounds"]
            cols, rows = os.get_terminal_size()
            if rows == rows_needed and abs(cols - cols_needed) <= 1:
                return
            nw = min(0.95, w * cols_needed / cols)
            nh = min(0.95, h * rows_needed / rows)
            rex_api("session.resize_layer", {"layer_id": layer["layer_id"],
                                             "bounds": [(1 - nw) / 2, (1 - nh) / 2.5, nw, nh]})
            time.sleep(0.12)
    except Exception:
        pass


def read_key():
    import termios, tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        return os.read(fd, 1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def popup(claude_dirs=None):
    try:
        data = collect(claude_dirs=claude_dirs)
        while True:
            render(data, popup=True)
            if read_key() not in (b"r", b"R"):
                break
            data = collect(fresh=True, claude_dirs=claude_dirs)
    finally:
        print("\033[?25h", end="", flush=True)


# ---- Rex integration -----------------------------------------------------
REX_BEGIN, REX_END = "-- >>> agentmeter >>>", "-- <<< agentmeter <<<"
REX_SNIPPET = """\
-- agentmeter: popup with Claude Code / Codex 5h + weekly usage remaining.
-- Managed by `agentmeter setup-rex` / `agentmeter remove-rex`.
rex.action{
  name     = "agent_usage",
  title    = "Show Agent Usage",
  keywords = "claude codex limits quota usage",
  run = function(ctx, args)
    local cmd = { %(bin)s, "--popup" }
    -- If the focused pane is running Claude Code, show that pane's account.
    local proc = rex.block.call("com.superlogical.terminal", "process", { block_id = ctx.block_id })
    local fg = proc and proc.foreground
    if fg and fg.pid then
      local id = ((fg.argv0 or "") .. " " .. (fg.invoked_path or "") .. " " .. (fg.path or "")):lower()
      if id:find("claude", 1, true) then
        table.insert(cmd, "--pid")
        table.insert(cmd, tostring(math.floor(fg.pid)))
      end
    end
    return rex.session.new_layer{
      session_id = ctx.session_id,
      bounds = { 0.28, 0.22, 0.44, 0.5 },
      focus  = true,
      layout = rex.layout.block{
        flavor  = "com.superlogical.terminal.shell",
        options = { command = cmd },
      },
    }
  end,
}
rex.bind(%(key)s, "agent_usage")
"""


def rex_config_path():
    if os.environ.get("REX_CONFIG"):
        return os.environ["REX_CONFIG"]
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "rex", "init.lua")


def rex(*args):
    try:
        return subprocess.run(["rex", *args], capture_output=True, text=True).returncode == 0
    except FileNotFoundError:
        return False


def strip_block(text):
    out, skip = [], False
    for line in text.splitlines(keepends=True):
        if line.rstrip("\n") == REX_BEGIN:
            skip = True
        if not skip:
            out.append(line)
        if line.rstrip("\n") == REX_END:
            skip = False
    return "".join(out).rstrip("\n") + "\n" if out else ""


def setup_rex(key, remove=False):
    path = rex_config_path()
    old = open(path).read() if os.path.exists(path) else ""
    new = strip_block(old)
    if not remove:
        # The path this command was run as, e.g. /opt/homebrew/bin/agentmeter, not a versioned Cellar path.
        bin_path = os.path.abspath(sys.argv[0])
        block = REX_SNIPPET % {"bin": json.dumps(bin_path), "key": json.dumps(key)}
        new = (new + "\n" if new else "") + f"{REX_BEGIN}\n{block}{REX_END}\n"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(new)
    if old and not remove and not rex("config", "check"):
        with open(path, "w") as fh:
            fh.write(old)
        sys.exit("Rex rejected the config; init.lua was left unchanged. Run `rex config check`.")
    rex("config", "reload")
    print(f"Removed the agentmeter popup from {path}." if remove
          else f"Rex popup ready: press {key} (or run `rex do agent_usage`).")


def arg_after(flag, default):
    return sys.argv[sys.argv.index(flag) + 1] if flag in sys.argv[:-1] else default


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "--version":
        print(f"agentmeter {VERSION}")
    elif cmd == "setup-rex":
        setup_rex(arg_after("--key", "shift+cmd+u"))
    elif cmd == "remove-rex":
        setup_rex(None, remove=True)
    elif cmd in ("-h", "--help"):
        print(__doc__.strip())
    else:
        dirs = None
        if "--pid" in sys.argv:          # popup opened from a pane running Claude Code
            dirs = [pane_claude_dir(arg_after("--pid", ""))]
        elif "--claude-config" in sys.argv:
            dirs = [os.path.expanduser(arg_after("--claude-config", "")).rstrip("/") or None]
        if "--popup" in sys.argv:
            popup(dirs)
            sys.exit()
        data = collect(claude_dirs=dirs)
        if "--json" in sys.argv:
            print(json.dumps(data, indent=2))
        else:
            render(data)
