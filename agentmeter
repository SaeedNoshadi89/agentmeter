#!/usr/bin/env python3
"""agentmeter: how much of your coding agents' usage limits is left.

Finds the agents installed on this machine and shows each one's limits:
  Claude Code  5-hour + weekly, per account   GET api.anthropic.com/api/oauth/usage
  Codex        5-hour + weekly                 last `rate_limits` in ~/.codex/sessions (local)
  OpenCode     per login in its auth.json      OpenRouter key budget, Claude subscription, ...
  others       listed when installed (Gemini CLI, Cursor Agent, Amp, Copilot CLI, ...)

Usage:
  agentmeter [--json] [--popup]               every agent found
  agentmeter --claude-config DIR               one Claude account (its CLAUDE_CONFIG_DIR)
  agentmeter --pid PID                         the account of a running Claude Code process
  agentmeter setup [--yes]                     set everything up in one step (asks first)
  agentmeter setup-rex [--key shift+cmd+u]   add the popup to Rex's init.lua
  agentmeter shortcut [KEY]                    show or change the popup's shortcut
  agentmeter style [float|pane]                open the Rex view floating or docked as a pane
  agentmeter statusline                        one line for Claude Code's statusLine setting
  agentmeter statusline on [--only a,b] | off | toggle | status
                                               the Claude Code status line (ids: claude codex opencode ...)
  agentmeter setup-claude [--only ...] [--force]   turn that status line on (--force replaces another one)
  agentmeter remove-claude                     turn it off
  agentmeter remove-rex                      take it out again
  agentmeter --no-icons                        text marks instead of the agents' icons
  agentmeter --demo [--popup]                  made-up accounts and numbers, for screenshots
  agentmeter --version
"""
import glob, json, os, subprocess, sys, time, urllib.request
from datetime import datetime, timezone

VERSION = "0.3.0"

CACHE = os.path.expanduser("~/.cache/agentmeter.json")
CACHE_TTL = 60


def meter(label, used, resets_at=None, detail=None):
    """One limit: share used (0-100) and when it resets. A past reset means it's fresh again."""
    if used is None:
        return None
    if resets_at and resets_at < time.time():
        used, resets_at = 0.0, None
    used = max(0.0, min(100.0, float(used)))
    return {"label": label, "used": used, "left": 100.0 - used, "resets_at": resets_at, "detail": detail}


def iso(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp() if ts else None


class FetchError(RuntimeError):
    """A failed check. `login` means signing in again helps; `retry_in` is how long to back off."""
    def __init__(self, message, login=False, retry_in=None):
        super().__init__(message)
        self.login, self.retry_in = login, retry_in


RATE_LIMIT_BACKOFF = 300      # seconds to wait after a 429 when the server doesn't say


def http_json(url, headers):
    req = urllib.request.Request(url, headers={"User-Agent": "agentmeter", **headers})
    try:
        return json.load(urllib.request.urlopen(req, timeout=8))
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            raise FetchError("login expired", login=True)
        if e.code == 429:
            try:
                wait = int(e.headers.get("Retry-After") or RATE_LIMIT_BACKOFF)
            except ValueError:
                wait = RATE_LIMIT_BACKOFF
            raise FetchError("rate limited, retrying soon", retry_in=max(60, wait))
        raise FetchError(f"service error {e.code}, retrying soon", retry_in=120)
    except (urllib.error.URLError, TimeoutError, OSError):
        raise FetchError("offline, retrying soon", retry_in=60)


# ---- Claude Code ---------------------------------------------------------
# Each Claude Code login lives in a config dir: the default (~/.claude, account
# info in ~/.claude.json) or one chosen with CLAUDE_CONFIG_DIR. On macOS its
# token is in the Keychain item "Claude Code-credentials", plus
# "-<first 8 hex of sha256(dir)>" for a custom dir.
import hashlib, re


def keychain_service(cfg):
    base = "Claude Code-credentials"
    return base if cfg is None else f"{base}-{hashlib.sha256(cfg.encode()).hexdigest()[:8]}"


def read_credentials(cfg):
    if sys.platform == "darwin":
        r = subprocess.run(["security", "find-generic-password", "-s", keychain_service(cfg), "-w"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return r.stdout
    p = os.path.join(cfg or os.path.expanduser("~/.claude"), ".credentials.json")
    return open(p).read() if os.path.exists(p) else None


def claude_email(cfg):
    p = os.path.join(cfg, ".claude.json") if cfg else os.path.expanduser("~/.claude.json")
    try:
        return (json.load(open(p)).get("oauthAccount") or {}).get("emailAddress")
    except Exception:
        return None


ACCOUNTS_CACHE = os.path.expanduser("~/.cache/agentmeter/accounts.json")


def claude_accounts():
    """Config dirs (None = default) that have a Claude Code login. Remembered for an hour,
    so opening the popup doesn't wait on Keychain reads."""
    try:
        cached = json.load(open(ACCOUNTS_CACHE))
        if time.time() - cached["at"] < 3600:
            return cached["dirs"]
    except Exception:
        pass
    dirs = find_claude_accounts()
    try:
        os.makedirs(os.path.dirname(ACCOUNTS_CACHE), exist_ok=True)
        with open(ACCOUNTS_CACHE, "w") as fh:
            json.dump({"at": time.time(), "dirs": dirs}, fh)
    except Exception:
        pass
    return dirs


def find_claude_accounts():
    """Config dirs (None = default) that have a Claude Code login."""
    found = [None] if read_credentials(None) else []
    for d in sorted(glob.glob(os.path.expanduser("~/.claude-*")) + glob.glob(os.path.expanduser("~/.config/claude*"))):
        if os.path.isdir(d) and read_credentials(d):
            found.append(d)
    return found or [None]


def pane_claude_dir(pid):
    """CLAUDE_CONFIG_DIR of a running Claude Code process (None = default dir)."""
    env = subprocess.run(["ps", "eww", "-p", str(pid), "-o", "command="], capture_output=True, text=True).stdout
    m = re.search(r"(?:^|\s)CLAUDE_CONFIG_DIR=(\S+)", env)
    return os.path.expanduser(m.group(1)).rstrip("/") if m else None


def claude_usage(token):
    d = http_json("https://api.anthropic.com/api/oauth/usage",
                  {"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"})
    f, w = d.get("five_hour") or {}, d.get("seven_day") or {}
    return {"meters": [meter("5-hour", f.get("utilization"), iso(f.get("resets_at"))),
                       meter("Weekly", w.get("utilization"), iso(w.get("resets_at")))]}


def claude(cfg):
    raw = read_credentials(cfg)
    if not raw:
        raise RuntimeError("not logged in (run `claude`)")
    try:
        return claude_usage(json.loads(raw)["claudeAiOauth"]["accessToken"])
    except FetchError as e:
        if e.login:
            raise FetchError(f"{e} (run `claude`)", login=True)
        raise


# ---- Codex ---------------------------------------------------------------
def codex():
    files = sorted(glob.glob(os.path.expanduser("~/.codex/sessions/*/*/*/rollout-*.jsonl")),
                   key=os.path.getmtime, reverse=True)
    for path in files[:20]:  # newest session that has rate-limit data
        last = None
        with open(path, errors="ignore") as fh:
            for line in fh:
                if '"rate_limits"' in line:
                    last = line
        if not last:
            continue
        rl = find_key(json.loads(last), "rate_limits")
        if not rl:
            continue
        meters = []
        for slot in ("primary", "secondary"):
            s = rl.get(slot) or {}
            label = "5-hour" if s.get("window_minutes", 0) <= 300 else "Weekly"
            meters.append(meter(label, s.get("used_percent"), s.get("resets_at")))
        return {"meters": meters, "as_of": os.path.getmtime(path)}
    raise RuntimeError("no Codex session data yet")


def find_key(obj, key):
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        obj = obj.values()
    if isinstance(obj, (list, type({}.values()))):
        for v in obj:
            r = find_key(v, key)
            if r:
                return r
    return None


# ---- OpenCode ------------------------------------------------------------
# OpenCode can sign in to many providers; ~/.local/share/opencode/auth.json
# holds one login per provider. Each becomes its own entry.
OPENCODE_AUTH = os.path.expanduser("~/.local/share/opencode/auth.json")
PROVIDER_NAMES = {"openrouter": "OpenRouter", "anthropic": "Claude", "openai": "OpenAI",
                  "github-copilot": "GitHub Copilot", "google": "Google"}


def openrouter(key):
    d = http_json("https://openrouter.ai/api/v1/key", {"Authorization": f"Bearer {key}"}).get("data") or {}
    limit, left = d.get("limit"), d.get("limit_remaining")
    if not limit:
        return {"meters": [], "note": f"${d.get('usage') or 0:.2f} spent, no budget set"}
    budget = d.get("effective_budget") or {}
    period = {"daily": "Daily", "weekly": "Weekly", "monthly": "Monthly"}.get(d.get("limit_reset"), "Budget")
    used = 100 * (1 - (left or 0) / limit)
    return {"meters": [meter(period, used, iso(budget.get("resets_at")), f"${left:,.0f} of ${limit:,.0f}")]}


def opencode_entries():
    try:
        auth = json.load(open(OPENCODE_AUTH))
    except Exception:
        return [("opencode", None, lambda: {"meters": [], "note": "not signed in to a provider"})]
    out = []
    for prov, cred in auth.items():
        name = PROVIDER_NAMES.get(prov, prov)
        if prov == "openrouter" and cred.get("key"):
            fetch = lambda k=cred["key"]: openrouter(k)
        elif prov == "anthropic" and cred.get("type") == "oauth":
            fetch = lambda c=cred: (claude_usage(c["access"]) if c.get("expires", 0) / 1000 > time.time()
                                    else {"meters": [], "note": "token expired, open OpenCode to refresh"})
        else:
            kind = "API key, pay as you go" if cred.get("type") == "api" else "no usage limits to show"
            fetch = lambda kind=kind: {"meters": [], "note": kind}
        out.append((f"opencode:{prov}", f"via {name}", fetch))
    return out


# ---- agent registry -------------------------------------------------------
# An agent is shown when its command is installed or its data folder exists.
# The PATH is widened because Rex starts the popup without your shell's PATH.
EXTRA_PATH = ["~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin", "~/.opencode/bin",
              "~/.bun/bin", "~/.npm-global/bin", "~/.volta/bin", "~/.cargo/bin"]


def installed(bins=(), paths=()):
    import shutil
    path = os.pathsep.join([os.environ.get("PATH", "")] + [os.path.expanduser(p) for p in EXTRA_PATH])
    return (any(shutil.which(b, path=path) for b in bins)
            or any(os.path.exists(os.path.expanduser(p)) for p in paths))


def listed_only(note="no usage limits to show"):
    return lambda: [("", None, lambda: {"meters": [], "note": note})]


# (id, display name, detect, entries) - entries -> [(key suffix, account, fetch)]
AGENTS = [
    ("claude", "Claude Code", lambda: installed(["claude"], ["~/.claude.json", "~/.claude"]), None),
    ("codex", "Codex", lambda: installed(["codex"], ["~/.codex/sessions"]),
     lambda: [("", None, codex)]),
    ("opencode", "OpenCode", lambda: installed(["opencode"], [OPENCODE_AUTH]), opencode_entries),
    ("gemini", "Gemini CLI", lambda: installed(["gemini"]), listed_only()),
    ("cursor", "Cursor Agent", lambda: installed(["cursor-agent"]), listed_only()),
    ("amp", "Amp", lambda: installed(["amp"]), listed_only()),
    ("copilot", "Copilot CLI", lambda: installed(["copilot"]), listed_only()),
    ("qwen", "Qwen Code", lambda: installed(["qwen"]), listed_only()),
    ("crush", "Crush", lambda: installed(["crush"]), listed_only()),
    ("droid", "Factory Droid", lambda: installed(["droid"]), listed_only()),
    ("aider", "Aider", lambda: installed(["aider"]), listed_only("uses your own API keys")),
]


def jobs_for(claude_dirs):
    jobs = []
    for aid, name, detect, entries in AGENTS:
        if aid == "claude":
            if claude_dirs is None and not detect():
                continue
            for d in (claude_dirs if claude_dirs is not None else claude_accounts()):
                jobs.append((f"claude:{d or 'default'}", aid, name, claude_email(d), lambda d=d: claude(d)))
        elif detect():
            for suffix, account, fetch in entries():
                jobs.append((suffix if ":" in suffix else aid + (f":{suffix}" if suffix else ""),
                             aid, name, account, fetch))
    return jobs


# ---- collect + cache -----------------------------------------------------
def demo_data():
    """Made-up accounts and numbers, for screenshots (--demo)."""
    now, h, d = time.time(), 3600, 86400
    def m(label, left, resets, detail=None):
        return meter(label, 100 - left, now + resets if resets else None, detail)
    return {
        "claude:work": {"agent": "claude", "label": "Claude Code", "account": "work@example.com",
                        "meters": [m("5-hour", 100, 0), m("Weekly", 22, 2 * d + 5 * h)]},
        "claude:personal": {"agent": "claude", "label": "Claude Code", "account": "personal@example.com",
                            "meters": [m("5-hour", 64, 1 * h + 40 * 60), m("Weekly", 88, 6 * d + 3 * h)]},
        "codex": {"agent": "codex", "label": "Codex", "account": None,
                  "meters": [m("5-hour", 91, 3 * h + 12 * 60), m("Weekly", 41, 4 * d + 2 * h)]},
        "opencode:openrouter": {"agent": "opencode", "label": "OpenCode", "account": "via OpenRouter",
                                "meters": [m("Monthly", 76, 24 * d, "$38 of $50")]},
    }


def load_cache():
    try:
        cache = json.load(open(CACHE))
        return cache if isinstance(cache, dict) and "data" not in cache else {}
    except Exception:
        return {}


def cached_view(claude_dirs=None):
    """Last known numbers for every entry, however old; "loading…" where there are none. Instant."""
    if "--demo" in sys.argv:
        return demo_data()
    cache, data = load_cache(), {}
    for key, aid, label, account, _ in jobs_for(claude_dirs):
        hit = cache.get(key)
        data[key] = (hit["data"] if hit and "agent" in hit["data"]
                     else {"agent": aid, "label": label, "account": account, "meters": [], "note": "loading…"})
    return data


def collect(fresh=False, claude_dirs=None):
    """Usage per entry, in display order. Entries older than CACHE_TTL are fetched in parallel."""
    if "--demo" in sys.argv:
        return demo_data()
    from concurrent.futures import ThreadPoolExecutor
    cache, now = load_cache(), time.time()
    jobs = jobs_for(claude_dirs)

    def run(job):
        key, aid, label, account, fn = job
        hit = cache.get(key)
        usable = hit and "agent" in hit["data"]
        if usable and hit.get("retry_at"):
            if now < hit["retry_at"]:                         # backing off after an error,
                return key, hit, False                        # even when asked to refresh
        elif usable and not fresh and now - hit["at"] < CACHE_TTL:
            return key, hit, False
        try:
            v = fn()
            v["meters"] = [m for m in v.get("meters", []) if m]
            v.update(agent=aid, label=label, account=account)
            return key, {"at": now, "data": v, "good_at": now}, True
        except Exception as e:
            retry_in = getattr(e, "retry_in", None) or CACHE_TTL
            last_good = hit and hit["data"].get("meters") and "error" not in hit["data"]
            if last_good:
                # Keep showing the last good numbers, marked with their time, and note the problem.
                v = dict(hit["data"], stale=str(e), as_of=hit.get("good_at", hit["at"]))
                return key, {"at": now, "data": v, "good_at": hit.get("good_at", hit["at"]),
                             "retry_at": now + retry_in}, True
            v = {"error": str(e), "agent": aid, "label": label, "account": account}
            return key, {"at": now, "data": v, "retry_at": now + retry_in}, True

    with ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(run, jobs))
    data = {}
    for key, entry, new in results:
        data[key] = entry["data"]
        if new:
            cache[key] = entry
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w") as fh:
        json.dump(cache, fh)
    return data


# ---- render --------------------------------------------------------------
# Minimal and theme-friendly: basic ANSI colors only (Rex maps them to its
# palette), thin line bars, muted secondary text, title in the pane header.
DIM, BOLD, RESET = "\033[2m", "\033[1m", "\033[0m"
# Each tool's own mark where it has one: Claude Code's spark in Claude orange,
# Codex CLI's prompt, Gemini's sparkle in Gemini blue.
ICONS = {"claude": ("\033[33m", "✻ "), "codex": ("", ">_"),   # theme colors only
         "gemini": ("\033[34m", "✦ "), "opencode": ("", "▣ ")}


ICON_SITES = {"claude": "claude.ai", "codex": "chatgpt.com", "opencode": "opencode.ai",
              "gemini": "gemini.google.com", "cursor": "cursor.com", "amp": "ampcode.com",
              "copilot": "github.com", "qwen": "qwen.ai", "crush": "charm.sh",
              "droid": "factory.ai", "aider": "aider.chat"}
ICON_DIR = os.path.expanduser("~/.cache/agentmeter/icons")


def images_supported():
    """Terminals that draw Kitty graphics: Rex, kitty, Ghostty, WezTerm."""
    if "--no-icons" in sys.argv or not sys.stdout.isatty():
        return False
    return bool(os.environ.get("REX_SESSION") or os.environ.get("KITTY_WINDOW_ID")
                or os.environ.get("TERM_PROGRAM") in ("ghostty", "WezTerm"))


def icon_png(aid):
    """The agent's site icon, downloaded once and cached. None if unavailable."""
    site = ICON_SITES.get(aid)
    if not site:
        return None
    path = os.path.join(ICON_DIR, f"{aid}.png")
    if not os.path.exists(path):
        try:
            url = f"https://www.google.com/s2/favicons?domain={site}&sz=64"
            png = urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "agentmeter"}),
                                         timeout=4).read()
            if not png.startswith(b"\x89PNG"):
                return None
            os.makedirs(ICON_DIR, exist_ok=True)
            with open(path, "wb") as fh:
                fh.write(png)
        except Exception:
            return None
    round_path = os.path.join(ICON_DIR, f"{aid}.round.png")
    if not os.path.exists(round_path):
        try:
            with open(round_path, "wb") as fh:
                fh.write(round_icon(open(path, "rb").read()))
        except Exception:
            return open(path, "rb").read()
    return open(round_path, "rb").read()


# ---- round icons (stdlib only: tiny PNG decode/encode) --------------------
def png_rgba(data):
    """Decode a non-interlaced PNG into (width, height, flat RGBA list)."""
    import struct, zlib
    pos, idat, pal, trns = 8, b"", None, b""
    while pos < len(data):
        n, kind = struct.unpack(">I4s", data[pos:pos + 8])
        chunk = data[pos + 8:pos + 8 + n]
        if kind == b"IHDR":
            w, h, depth, ctype, _, _, interlace = struct.unpack(">IIBBBBB", chunk)
        elif kind == b"PLTE":
            pal = [tuple(chunk[i:i + 3]) for i in range(0, len(chunk), 3)]
        elif kind == b"tRNS":
            trns = chunk
        elif kind == b"IDAT":
            idat += chunk
        pos += n + 12
    if interlace or (depth != 8 and ctype != 3):
        raise ValueError("unsupported PNG")
    chans = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}[ctype]
    bpp = max(1, chans * depth // 8)
    stride = (w * chans * depth + 7) // 8
    raw, prev, rows = zlib.decompress(idat), bytearray(stride), []
    for y in range(h):
        f, line = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            a_, b_ = line[i - bpp] if i >= bpp else 0, prev[i]
            c_ = prev[i - bpp] if i >= bpp else 0
            if f == 1: line[i] = (line[i] + a_) & 255
            elif f == 2: line[i] = (line[i] + b_) & 255
            elif f == 3: line[i] = (line[i] + (a_ + b_) // 2) & 255
            elif f == 4:
                pa, pb, pc = abs(b_ - c_), abs(a_ - c_), abs(a_ + b_ - 2 * c_)
                line[i] = (line[i] + (a_ if pa <= pb and pa <= pc else b_ if pb <= pc else c_)) & 255
        rows.append(line)
        prev = line
    px = []
    for line in rows:
        for x in range(w):
            if ctype == 3:
                bit = x * depth
                idx = (line[bit // 8] >> (8 - depth - bit % 8)) & ((1 << depth) - 1)
                r, g, b = pal[idx]
                px += [r, g, b, trns[idx] if idx < len(trns) else 255]
            elif ctype == 6: px += line[x * 4:x * 4 + 4]
            elif ctype == 2: px += list(line[x * 3:x * 3 + 3]) + [255]
            elif ctype == 4: px += [line[x * 2]] * 3 + [line[x * 2 + 1]]
            else: px += [line[x]] * 3 + [255]
    return w, h, px


def rgba_png(w, h, px):
    import struct, zlib
    raw = b"".join(b"\0" + bytes(px[y * w * 4:(y + 1) * w * 4]) for y in range(h))
    def chunk(kind, body):
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


def round_icon(png, size=64):
    """Crop to an anti-aliased circle. Icons with see-through corners get a white disc behind them."""
    w, h, src = png_rgba(png)
    opaque = src[3] > 200 and src[(w * h - 1) * 4 + 3] > 200
    scale = 1.0 if opaque else 0.68          # inset transparent logos inside the disc
    out, r = [], size / 2
    for y in range(size):
        for x in range(size):
            # coverage of the circle, sampled 4x per pixel for smooth edges
            cover = sum(((x + dx) - r) ** 2 + ((y + dy) - r) ** 2 <= r * r
                        for dx in (0.25, 0.75) for dy in (0.25, 0.75)) / 4
            u = ((x + 0.5 - r) / scale + r) * w / size
            v = ((y + 0.5 - r) / scale + r) * h / size
            if 0 <= u < w and 0 <= v < h:
                i = (int(v) * w + int(u)) * 4
                sr, sg, sb, sa = src[i:i + 4]
            else:
                sr = sg = sb = sa = 0
            if opaque:
                pr, pg, pb, pa = sr, sg, sb, sa
            else:                              # logo over white
                k = sa / 255
                pr, pg, pb = (round(c * k + 255 * (1 - k)) for c in (sr, sg, sb))
                pa = 255
            out += [pr, pg, pb, round(pa * cover)]
    return rgba_png(size, size, out)


def kitty_image(png, cols=3):
    """Draw a PNG `cols` cells wide at the cursor, then step past it."""
    import base64
    data = base64.b64encode(png).decode()
    chunks = [data[i:i + 4096] for i in range(0, len(data), 4096)]
    out = ""
    for i, c in enumerate(chunks):
        # Width only, so the terminal keeps the icon round. C=1: cursor stays; q=2: no replies.
        head = f"f=100,a=T,c={cols},Y=3,C=1,q=2," if i == 0 else "q=2,"
        out += f"\033_G{head}m={int(i < len(chunks) - 1)};{c}\033\\"
    return out + " " * (cols + 1)


def icon(aid, muted=False):
    if images_supported():
        png = icon_png(aid)
        if png:
            return kitty_image(png)
    color, mark = ICONS.get(aid, ("", "◆ "))
    return f"{DIM if muted else color}{BOLD}{mark}{RESET}  "


GREEN, ORANGE, RED = "\033[32m", "\033[33m", "\033[31m"  # theme colors: Rex draws its yellow slot as orange


def tone(left):
    """Color for the share left, same for every agent and window."""
    return GREEN if left >= 50 else ORANGE if left >= 30 else RED


def bar(m, width):
    """Thin bar with half-cell precision: ━ full, ╸ half, ─ track."""
    halves = round(m["left"] / 100 * width * 2)
    full, half = divmod(halves, 2)
    filled = "━" * full + ("╸" if half else "")
    return f"{tone(m['left'])}{filled}{RESET}{DIM}{'─' * (width - len(filled))}{RESET}"


def reset_text(ts):
    if not ts:
        return ""
    secs = ts - time.time()
    if secs < 86400:
        h, m = int(secs // 3600), int(secs % 3600 // 60)
        return f"resets in {h}h {m:02d}m" if h else f"resets in {m}m"
    fmt = "%a %H:%M" if secs < 6 * 86400 else "%b %d"
    return "resets " + time.strftime(fmt, time.localtime(ts))


def visible_len(text):
    import re
    return len(re.sub(r"\033_G.*?\033\\|\033\[[0-9;?]*[A-Za-z]", "", text))


SHORT = {"5-hour": "5h", "Weekly": "week", "Monthly": "month", "Daily": "day", "Budget": "budget"}


def lines_for(data, bar_w):
    out = []
    for u in data.values():
        aid = u.get("agent", "")
        title = f"{BOLD}{u.get('label', aid)}{RESET}"
        if u.get("account"):
            title += f"  {DIM}{u['account']}{RESET}"
        if "as_of" in u:
            title += f"   {DIM}as of {time.strftime('%H:%M', time.localtime(u['as_of']))}"
            title += f" · {u['stale']}{RESET}" if u.get("stale") else f"{RESET}"
        quiet = "error" in u or not u.get("meters")
        out.append(f"{icon(aid, muted=quiet)}{title}")
        if "error" in u or u.get("note"):
            out.append(f"    {DIM}{u.get('error') or u['note']}{RESET}")
        for m in u.get("meters", []):
            extra = "  ".join(x for x in (m.get("detail"), reset_text(m.get("resets_at"))) if x)
            out.append(f"    {DIM}{SHORT.get(m['label'], m['label']):<6}{RESET}{bar(m, bar_w)}  "
                       f"{tone(m['left'])}{m['left']:3.0f}%{RESET}  {DIM}{extra}{RESET}")
        out.append("")
    return out


_last_fit = None


def render(data, popup=False, busy=False, docked=False):
    global _last_fit
    import shutil
    if not popup:
        cols = shutil.get_terminal_size((80, 24)).columns
        body = lines_for(data, max(10, min(28, cols - 50)))
        print("\n" + "\n".join("  " + l for l in body))
        return
    body = lines_for(data, 16)
    while body and not body[-1]:
        body.pop()
    size = (len(body) + 2, max(visible_len(l) for l in body) + 4)
    if docked:
        body += ["", f"{DIM}r refresh   f float   q close{RESET}"]
    fit_needed = not docked and size != _last_fit
    title = "Agent usage · updating…" if busy else "Agent usage"
    # Redraw in place: home, rewrite each line, clear the rest. No full-screen clear, so no blink.
    lines = [""] + ["  " + l for l in body]
    print(f"\033]2;{title}\007\033[?25l\033_Ga=d,q=2\033\\\033[H"
          + "\n".join(l + "\033[K" for l in lines) + "\033[J", end="", flush=True)
    if fit_needed:                               # after drawing, so nothing waits on Rex
        _last_fit = size
        fit_rex_layer(*size)


def rex_api(method, args):
    """Call the Rex server API from inside a Rex pane; None when not in Rex."""
    import shutil
    bin_dir = os.environ.get("REX_BIN_DIR", "")
    rex_bin = os.path.join(bin_dir, "rex") if os.path.exists(os.path.join(bin_dir, "rex")) else shutil.which("rex")
    if not rex_bin or not os.environ.get("REX_SESSION"):
        return None
    r = subprocess.run([rex_bin, "api", "call", "-s", os.environ["REX_SESSION"], method, json.dumps(args)],
                       capture_output=True, text=True, timeout=3)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None


POPUP_BOUNDS = os.path.expanduser("~/.cache/agentmeter/popup-bounds.json")


def save_popup_bounds(bounds):
    try:
        os.makedirs(os.path.dirname(POPUP_BOUNDS), exist_ok=True)
        with open(POPUP_BOUNDS, "w") as fh:
            json.dump([round(v, 4) for v in bounds], fh)
    except Exception:
        pass


def fit_rex_layer(rows_needed, cols_needed):
    """Shrink the popup's floating layer to fit its content, centred in the window."""
    block = os.environ.get("REX_BLOCK")
    if not block:
        return
    try:
        for _ in range(3):  # the pane header isn't counted in rows, so converge in a few steps
            view = rex_api("session.view", {}) or {}
            layer = next((l for w in view.get("windows", []) for l in w.get("layers", [])
                          if l.get("kind") != "tiled" and any(b.get("block_id") == block for b in l.get("blocks", []))),
                         None)
            if not layer:
                return
            _, _, w, h = layer["bounds"]
            cols, rows = os.get_terminal_size()
            if rows == rows_needed and abs(cols - cols_needed) <= 1:
                save_popup_bounds(layer["bounds"])   # the shortcut opens at this size next time
                return
            nw = min(0.95, w * cols_needed / cols)
            nh = min(0.95, h * rows_needed / rows)
            rex_api("session.resize_layer", {"layer_id": layer["layer_id"],
                                             "bounds": [(1 - nw) / 2, (1 - nh) / 2, nw, nh]})
            time.sleep(0.12)
    except Exception:
        pass


# ---- Claude Code status line ---------------------------------------------
def refresh_in_background():
    """Start `agentmeter --refresh` detached, unless one started in the last CACHE_TTL."""
    stamp = CACHE + ".refreshing"
    try:
        if time.time() - os.path.getmtime(stamp) < CACHE_TTL:
            return
    except OSError:
        pass
    open(stamp, "w").close()
    subprocess.Popen([sys.executable, os.path.abspath(sys.argv[0]), "--refresh"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def statusline():
    """One line for Claude Code's statusLine: this session's account first, then other agents.

    Reads only the cache, so it's instant; stale numbers are refreshed in the background."""
    try:
        sys.stdin.read()          # Claude Code sends session JSON; not needed
    except Exception:
        pass
    cfg = os.environ.get("CLAUDE_CONFIG_DIR")
    mine = f"claude:{os.path.expanduser(cfg).rstrip('/') if cfg else 'default'}"
    if "--demo" in sys.argv:
        mine = "claude:personal"
    cache, now = load_cache(), time.time()
    view = cached_view()
    if any(now - (cache.get(k) or {}).get("at", 0) > CACHE_TTL for k in view):
        refresh_in_background()

    def short(u):
        parts = []
        for m in u.get("meters", []):
            label = SHORT.get(m["label"], m["label"])
            reset = reset_text(m.get("resets_at")).replace("resets in ", "").replace("resets ", "")
            reset = f"({reset})" if reset and m["left"] < 50 else ""
            parts.append(f"{DIM}{label}{RESET} {tone(m['left'])}{m['left']:.0f}%{RESET}"
                         + (f" {DIM}{reset}{RESET}" if reset else ""))
        return f" {DIM}·{RESET} ".join(parts)

    only = [a.strip() for a in arg_after("--only", "").split(",") if a.strip()]
    out = []
    for key in sorted(view, key=lambda k: k != mine):
        u = view[key]
        if only and u.get("agent") not in only:
            continue
        if key.startswith("claude:") and key != mine and mine in view:
            continue                                    # other Claude accounts: only in the popup
        color, mark = ICONS.get(u.get("agent"), ("", "◆ "))
        body = short(u) or f"{DIM}{u.get('note') or u.get('error') or ''}{RESET}"
        out.append(f"{color}{mark.strip()}{RESET} {body}")
    print("   ".join(out))


FOCUS_ON, FOCUS_OFF = "\033[?1004h", "\033[?1004l"  # terminal reports focus in (ESC[I) / out (ESC[O)


def my_layer():
    """The Rex layer holding this pane, or None outside Rex."""
    block = os.environ.get("REX_BLOCK")
    view = rex_api("session.view", {}) if block else None
    for w in (view or {}).get("windows", []):
        for layer in w.get("layers", []):
            if any(b.get("block_id") == block for b in layer.get("blocks", [])):
                return layer
    return None


def focus_moved_away():
    """After a focus-out report, confirm with Rex that another pane really has focus.
    Moving a pane (dock/float) reports a brief out-and-in that must not close it."""
    block = os.environ.get("REX_BLOCK")
    time.sleep(0.25)
    view = rex_api("session.view", {}) if block else None
    for w in (view or {}).get("windows", []):
        if any(b.get("block_id") == block for l in w.get("layers", []) for b in l.get("blocks", [])):
            return w.get("focused_block_id") != block
    return True


def is_docked():
    layer = my_layer()
    return bool(layer) and layer.get("kind") == "tiled"


def dock(anchor):
    if anchor and os.environ.get("REX_BLOCK"):
        rex_api("session.move_block", {"block_id": os.environ["REX_BLOCK"], "anchor_block_id": anchor,
                                       "direction": "horizontal", "side": "after", "ratio": 0.68})


def undock():
    global _last_fit
    if os.environ.get("REX_BLOCK"):
        rex_api("session.float_block", {"block_id": os.environ["REX_BLOCK"],
                                        "bounds": [0.28, 0.22, 0.44, 0.5]})
        rex_api("session.focus_block", {"block_id": os.environ["REX_BLOCK"]})
        _last_fit = None                          # refit the new floating layer


def popup(claude_dirs=None):
    """Draw at once from the cache and refresh in the background.

    Floating: any key or a click outside closes it; d docks it as a pane.
    Docked:   stays open and refreshes every minute; f floats it, q or Esc closes it."""
    import select, termios, threading, tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    anchor = arg_after("--from", "") or None
    result, worker = {}, None
    state = {"docked": False, "last": 0.0}

    def show(busy=False):
        render(result.get("data") or cached_view(claude_dirs), popup=True, busy=busy,
               docked=state["docked"])

    def refresh(fresh):
        nonlocal worker
        result.clear()
        state["last"] = time.time()
        worker = threading.Thread(target=lambda: result.update(data=collect(fresh, claude_dirs)), daemon=True)
        worker.start()

    import signal
    resized = {"flag": False}
    signal.signal(signal.SIGWINCH, lambda *_: resized.update(flag=True))   # redraw when the pane resizes

    try:
        tty.setcbreak(fd)
        print(FOCUS_ON, end="", flush=True)
        show(busy=True)                          # draw first, then ask Rex about the layout
        state["docked"] = is_docked()
        if state["docked"]:
            show(busy=True)
        refresh(False)
        busy = True
        while True:
            if busy and not worker.is_alive():
                show()
                busy = False
            if resized["flag"]:
                resized["flag"] = False
                show(busy=busy)
            if state["docked"] and not busy and time.time() - state["last"] > CACHE_TTL:
                show(busy=True)
                refresh(False)
                busy = True
            if not select.select([fd], [], [], 0.05)[0]:
                continue
            keys = os.read(fd, 64)
            if keys == b"\033[I":                          # gained focus
                continue
            if b"\033[O" in keys:                          # lost focus: close only when floating
                if keys.rfind(b"\033[I") > keys.rfind(b"\033[O"):
                    continue                                # out-and-in from a layout change
                state["docked"] = is_docked()
                if state["docked"] or not focus_moved_away():
                    continue
                break
            if keys in (b"r", b"R") and not busy:
                show(busy=True)
                refresh(True)
                busy = True
            elif keys in (b"d", b"D") and not state["docked"]:
                dock(anchor)
                state["docked"] = is_docked()
                show(busy=busy)
            elif keys in (b"f", b"F") and state["docked"]:
                undock()
                state["docked"] = is_docked()
                show(busy=busy)
            elif state["docked"] and keys not in (b"q", b"Q", b"\033"):
                continue                                    # docked: only q / Esc close it
            else:
                break
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        print(FOCUS_OFF + "\033[?25h", end="", flush=True)


# ---- Rex integration -----------------------------------------------------
REX_BEGIN, REX_END = "-- >>> agentmeter >>>", "-- <<< agentmeter <<<"
REX_SNIPPET = """\
-- agentmeter: usage limits left for your coding agents.
-- Managed by agentmeter (`agentmeter setup-rex`, `shortcut`, `style`, `remove-rex`).
local agentmeter_style = %(style)s   -- "float" or "pane"
rex.action{
  name     = "agent_usage",
  title    = "Show Agent Usage",
  keywords = "claude codex limits quota usage",
  run = function(ctx, args)
    local cmd = { %(bin)s, "--popup", "--from", ctx.block_id or "" }
    local layout = rex.layout.block{
      flavor  = "com.superlogical.terminal.shell",
      options = { command = cmd, shell = "none" },   -- start directly: no shell startup
    }
    if agentmeter_style == "pane" and ctx.block_id then
      return rex.session.new_split{
        session_id = ctx.session_id, anchor_id = ctx.block_id,
        direction = "horizontal", side = "after", ratio = 0.68, focus = true, layout = layout,
      }
    end
    -- Open at the size the popup fitted itself to last time, so it doesn't jump.
    local bounds = { 0.28, 0.22, 0.44, 0.5 }
    local f = io.open((os.getenv("HOME") or "") .. "/.cache/agentmeter/popup-bounds.json")
    if f then
      local saved = {}
      for n in f:read("*a"):gmatch("[%%d%%.]+") do saved[#saved + 1] = tonumber(n) end
      f:close()
      if #saved == 4 and saved[3] > 0.05 and saved[4] > 0.05 then bounds = saved end
    end
    return rex.session.new_layer{
      session_id = ctx.session_id,
      bounds = bounds,
      focus  = true,
      layout = layout,
    }
  end,
}
rex.bind(%(key)s, "agent_usage")
rex.action{
  name     = "agent_usage_statusline",
  title    = "Toggle Agent Usage in Claude Code Status Line",
  keywords = "agentmeter claude statusline footer bottom on off",
  run = function(ctx, args)
    rex.exec({ %(bin)s, "statusline", "toggle" })
  end,
}
"""


def rex_config_path():
    if os.environ.get("REX_CONFIG"):
        return os.environ["REX_CONFIG"]
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "rex", "init.lua")


def rex(*args):
    try:
        return subprocess.run(["rex", *args], capture_output=True, text=True).returncode == 0
    except FileNotFoundError:
        return False


def strip_block(text):
    out, skip = [], False
    for line in text.splitlines(keepends=True):
        if line.rstrip("\n") == REX_BEGIN:
            skip = True
        if not skip:
            out.append(line)
        if line.rstrip("\n") == REX_END:
            skip = False
    return "".join(out).rstrip("\n") + "\n" if out else ""


DEFAULT_KEY = "shift+cmd+u"


def current_key(text):
    m = re.search(r'rex\.bind\("([^"]+)", "agent_usage"\)', text)
    return m.group(1) if m else None


def current_style(text):
    m = re.search(r'local agentmeter_style = "(float|pane)"', text)
    return m.group(1) if m else None


def setup_rex(key, remove=False, style=None):
    path = rex_config_path()
    old = open(path).read() if os.path.exists(path) else ""
    key = key or current_key(old) or DEFAULT_KEY
    style = style or current_style(old) or "float"
    new = strip_block(old)
    if not remove:
        # The path this command was run as, e.g. /opt/homebrew/bin/agentmeter, not a versioned Cellar path.
        bin_path = os.path.abspath(sys.argv[0])
        block = REX_SNIPPET % {"bin": json.dumps(bin_path), "key": json.dumps(key), "style": json.dumps(style)}
        new = (new + "\n" if new else "") + f"{REX_BEGIN}\n{block}{REX_END}\n"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(new)
    if old and not remove and not rex("config", "check"):
        with open(path, "w") as fh:
            fh.write(old)
        sys.exit("Rex rejected the config; init.lua was left unchanged. Run `rex config check`.")
    rex("config", "reload")
    print(f"Removed the agentmeter popup from {path}." if remove
          else f"Rex popup ready: press {key} (or run `rex do agent_usage`). Opens as: {style}.")


PREFS = os.path.expanduser("~/.config/agentmeter/prefs.json")


def prefs(update=None):
    try:
        data = json.load(open(PREFS))
    except Exception:
        data = {}
    if update:
        data.update(update)
        os.makedirs(os.path.dirname(PREFS), exist_ok=True)
        with open(PREFS, "w") as fh:
            json.dump(data, fh, indent=2)
    return data


def claude_settings_paths():
    return [os.path.join(cfg or os.path.expanduser("~/.claude"), "settings.json") for cfg in claude_accounts()]


def statusline_enabled():
    for path in claude_settings_paths():
        try:
            if "agentmeter" in (json.load(open(path)).get("statusLine") or {}).get("command", ""):
                return True
        except Exception:
            pass
    return False


def setup_claude(remove=False):
    """Add (or remove) `agentmeter statusline` in every Claude Code config folder's settings.json."""
    command = f"{os.path.abspath(sys.argv[0])} statusline"
    if "--only" in sys.argv:
        only = arg_after("--only", "")
    elif "statusline_only" in prefs():
        only = prefs()["statusline_only"]
    else:                                   # set up before prefs existed: read it from settings
        only = ""
        for path in claude_settings_paths():
            try:
                m = re.search(r"--only (\S+)", (json.load(open(path)).get("statusLine") or {}).get("command", ""))
                if m:
                    only = m.group(1)
                    break
            except Exception:
                pass
    prefs({"statusline_only": only})
    if only:
        command += f" --only {only}"
    for path in claude_settings_paths():
        try:
            settings = json.load(open(path)) if os.path.exists(path) else {}
        except Exception:
            print(f"skipped {path}: not valid JSON")
            continue
        current = (settings.get("statusLine") or {}).get("command", "")
        if remove:
            if "agentmeter" not in current:
                continue
            settings.pop("statusLine")
            note = "removed"
        elif current and "agentmeter" not in current and "--force" not in sys.argv:
            print(f"skipped {path}: it already has a status line ({current})")
            continue
        else:
            settings["statusLine"] = {"type": "command", "command": command, "padding": 0}
            note = "status line on"
        if os.path.exists(path):
            with open(path + ".bak", "w") as fh:
                fh.write(open(path).read())
        with open(path, "w") as fh:
            json.dump(settings, fh, indent=2)
            fh.write("\n")
        print(f"{note}: {path}")
    print("New Claude Code sessions pick this up." if not remove else "Restart Claude Code sessions to hide it.")


def ask(question, default=True, unattended=None):
    """Yes/no question on the terminal. Works under `curl | sh` by reading /dev/tty.
    With --yes the default is taken. With no terminal, `unattended` is (default if None)."""
    if "--yes" in sys.argv or "-y" in sys.argv:
        return default
    try:
        tty_in = open("/dev/tty")
    except OSError:
        return default if unattended is None else unattended
    hint = "Y/n" if default else "y/N"
    sys.stdout.write(f"  {question} [{hint}] ")
    sys.stdout.flush()
    answer = tty_in.readline().strip().lower()
    tty_in.close()
    return default if not answer else answer.startswith("y")


def rex_installed():
    return installed(["rex"])


def rex_set_up():
    path = rex_config_path()
    return os.path.exists(path) and REX_BEGIN in open(path).read()


def setup_all():
    """One step after installing: find agents, then offer the Rex popup and the status line."""
    print(f"\n  {BOLD}agentmeter setup{RESET}\n")
    found = [name for aid, name, detect, _ in AGENTS if detect()]
    print(f"  Agents found: {', '.join(found) if found else 'none yet (sign in to an agent first)'}\n")

    if "--no-rex" in sys.argv:
        pass
    elif not rex_installed():
        print(f"  {DIM}Rex not found, skipping the popup. Run `agentmeter setup-rex` after installing Rex.{RESET}")
    elif ask(f"Add the Rex popup on {current_key(open(rex_config_path()).read()) if rex_set_up() else DEFAULT_KEY}?"):
        print("  ", end="")
        setup_rex(arg_after("--key", None))

    if "--no-statusline" in sys.argv:
        pass
    elif not installed(["claude"], ["~/.claude.json"]):
        print(f"  {DIM}Claude Code not found, skipping the status line.{RESET}")
    elif ask("Show your limits in Claude Code's status line?", unattended=False):
        if "--only" not in sys.argv and "statusline_only" not in prefs():
            default_only = ["claude"] + (["codex"] if "Codex" in found else [])
            sys.argv += ["--only", ",".join(default_only)]
        setup_claude()

    print(f"\n  {BOLD}Done.{RESET} Try it:")
    if rex_set_up():
        print(f"    In Rex, press {current_key(open(rex_config_path()).read())}")
    if statusline_enabled():
        print("    In Claude Code, start a new session to see the status line")
    print("    In any terminal, run: agentmeter")
    print(f"\n  Change anything later with `agentmeter shortcut`, `agentmeter style` or `agentmeter statusline`.\n")


def arg_after(flag, default):
    return sys.argv[sys.argv.index(flag) + 1] if flag in sys.argv[:-1] else default


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "--version":
        print(f"agentmeter {VERSION}")
    elif cmd == "setup":
        setup_all()
    elif cmd == "setup-rex":
        setup_rex(arg_after("--key", None))
    elif cmd == "style":
        if len(sys.argv) < 3 or sys.argv[2] not in ("float", "pane"):
            path = rex_config_path()
            current = current_style(open(path).read()) if os.path.exists(path) else None
            print(current or "float")
            if len(sys.argv) >= 3:
                sys.exit("usage: agentmeter style [float|pane]")
        else:
            setup_rex(None, style=sys.argv[2])
    elif cmd == "setup-claude":
        setup_claude()
    elif cmd == "remove-claude":
        setup_claude(remove=True)
    elif cmd == "statusline":
        sub = sys.argv[2] if len(sys.argv) > 2 else ""
        if sub == "on":
            setup_claude()
        elif sub == "off":
            setup_claude(remove=True)
        elif sub == "toggle":
            setup_claude(remove=statusline_enabled())
        elif sub == "status":
            only = prefs().get("statusline_only")
            print(("on" + (f" (only: {only})" if only else " (all agents)")) if statusline_enabled() else "off")
        else:
            statusline()            # called by Claude Code: print the line
    elif cmd == "--refresh":
        collect(fresh=True)
    elif cmd == "shortcut":
        if len(sys.argv) < 3:
            path = rex_config_path()
            key = current_key(open(path).read()) if os.path.exists(path) else None
            print(key or "not set up (run `agentmeter setup-rex`)")
        else:
            setup_rex(sys.argv[2])
    elif cmd == "remove-rex":
        setup_rex(None, remove=True)
    elif cmd in ("-h", "--help"):
        print(__doc__.strip())
    else:
        dirs = None
        if "--pid" in sys.argv:          # popup opened from a pane running Claude Code
            dirs = [pane_claude_dir(arg_after("--pid", ""))]
        elif "--claude-config" in sys.argv:
            dirs = [os.path.expanduser(arg_after("--claude-config", "")).rstrip("/") or None]
        if "--popup" in sys.argv:
            popup(dirs)
            sys.exit()
        data = collect(claude_dirs=dirs)
        if "--json" in sys.argv:
            print(json.dumps(data, indent=2))
        else:
            render(data)
            if sys.stdout.isatty() and not rex_set_up() and not statusline_enabled():
                print(f"  {DIM}Tip: run `agentmeter setup` to add the Rex popup and the Claude Code status line.{RESET}\n")
